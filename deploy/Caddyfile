# подписатьэцп.рф (punycode: xn--80ahmweccok4b0dm.xn--p1ai)
# Caddy сам получает и продлевает сертификат HTTPS (Let's Encrypt).
xn--80ahmweccok4b0dm.xn--p1ai, www.xn--80ahmweccok4b0dm.xn--p1ai {
	@www host www.xn--80ahmweccok4b0dm.xn--p1ai
	redir @www https://xn--80ahmweccok4b0dm.xn--p1ai{uri} permanent

	# /help/ → /help (раздел «Помощь» — это файл help.html рядом с папкой help/)
	redir /help/ /help permanent

	root * C:\podpisat\site
	encode zstd gzip
	try_files {path} {path}.html
	file_server

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
	}
	@files path /files/*
	header @files Content-Disposition attachment
	@assets path /static/*
	header @assets Cache-Control "public, max-age=3600"
	@pages not path /static/* /files/*
	header @pages Cache-Control no-cache

	handle_errors {
		rewrite * /index.html
		file_server
	}

	# Технический журнал без персональных данных: IP-адреса и заголовки браузера не записываются
	# (см. /privacy). Остаются время, страница, код ответа и размер — чтобы видеть ошибки.
	log {
		output file C:\podpisat\logs\access.log {
			roll_size 10MiB
			roll_keep 5
		}
		format filter {
			wrap json
			request>remote_ip delete
			request>remote_port delete
			request>client_ip delete
			request>headers delete
		}
	}
}
